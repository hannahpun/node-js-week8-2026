{
  "name": "school-grade-system",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "W8 考場 — 校園成績系統：你設計 schema，讓它活過來。",
  "scripts": {
    "start": "node scripts/check-docker.js && docker compose up -d && node scripts/wait-db.js",
    "stop": "docker compose stop",
    "db:reset": "docker compose down -v && docker compose up -d && node scripts/wait-db.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx db/seed.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.13.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "tsx": "^4.23.5"
  }
}
